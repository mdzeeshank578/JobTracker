{
  "manifest_version": 3,
  "name": "JobTracker Sync",
  "version": "1.0.0",
  "description": "Automatically sync your job applications to your JobTracker dashboard.",
  "permissions": [
    "storage",
    "notifications",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "*://*.indeed.com/*",
    "*://*.glassdoor.com/*",
    "*://*.wellfound.com/*",
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://*.workdayjobs.com/*",
    "*://*.ashbyhq.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.indeed.com/*",
        "*://*.glassdoor.com/*",
        "*://*.wellfound.com/*",
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.workdayjobs.com/*",
        "*://*.ashbyhq.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  }
}
