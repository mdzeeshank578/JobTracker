# ===================================================
# JOBTRACKER PROFESSIONAL CUSTOM DOMAIN CONFIGURATION
# ===================================================

# 🌐 1. FRONTEND APP DOMAIN CONFIG (Vercel / Netlify / Cloudflare Pages)
# Custom Domain: https://app.jobtracker.io (or https://jobtracker.app)
VITE_API_BASE_URL=https://api.jobtracker.io/api
VITE_LIVE_JOBS_API_BASE=https://ai.jobtracker.io

# ⚡ 2. EXPRESS BACKEND REST API DOMAIN CONFIG (Render / Railway / AWS ECS)
# Custom Domain: https://api.jobtracker.io
NODE_ENV=production
PORT=5001
FRONTEND_URL=https://app.jobtracker.io,https://jobtracker.app
BACKEND_URL=https://api.jobtracker.io

# Database Connection (Supabase / Managed PostgreSQL)
DATABASE_URL=postgresql://postgres:STRONG_PASSWORD@db.jobtracker.supabase.co:5432/postgres
SUPABASE_URL=https://jobtracker.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Auth & OAuth Callbacks
JWT_SECRET=YOUR_SECURE_RANDOM_256BIT_SECRET
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 🤖 3. PYTHON AI & JOB SEARCH AGGREGATOR DOMAIN CONFIG (Render / Railway)
# Custom Domain: https://ai.jobtracker.io
FRONTEND_ORIGIN=https://app.jobtracker.io,https://jobtracker.app
GROQ_API_KEY=gsk_your_groq_production_key
GROQ_MODEL=llama-3.3-70b-versatile
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
JOOBLE_API_KEY=your_jooble_api_key
